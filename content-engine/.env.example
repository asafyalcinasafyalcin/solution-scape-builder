# ProcessTürk Content Engine — ortam değişkenleri
# Bu dosyayı `.env` olarak kopyalayıp değerleri doldurun. `.env` ASLA commit edilmez.

# --- AI (Faz 1: zorunlu) ---
# https://console.anthropic.com adresinden alınır
ANTHROPIC_API_KEY=

# Üretimde kullanılacak Claude modeli (varsayılan: claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Veritabanı ---
# SQLite dosya yolu (varsayılan: ./data/content-engine.db)
DATABASE_PATH=./data/content-engine.db

# --- API / Panel ---
# API sunucusunun dinleyeceği port
PORT=8787
# Paneli/API'yi korumak için basit bearer token (rastgele uzun bir dize üretin)
DASHBOARD_AUTH_TOKEN=

# --- Haber API (opsiyonel — Faz 1'de RSS yeterli) ---
NEWS_API_KEY=

# --- LinkedIn (Faz 2/3'te doldurulacak — Faz 1'de boş bırakılabilir) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8787/auth/linkedin/callback
