# =============================================
# Amazon Selling Partner API (SP-API)
# =============================================
# https://developer-docs.amazon.com/sp-api
# Seller Central > Apps & Services > Develop Apps > SP-API

AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
# BAE marketplace kodu — değiştirme
AMAZON_MARKETPLACE_ID=A2VIGQ35RCS4UG
# EU endpoint — değiştirme
AMAZON_ENDPOINT=https://sellingpartnerapi-eu.amazon.com
# Sandbox için: https://sandbox.sellingpartnerapi-eu.amazon.com
AMAZON_SANDBOX=false

# =============================================
# noon Partner API
# =============================================
# Seller Lab > User & Access > API Users > .json key dosyasını indir
# Dosyayı backend/noon/store_credentials.json olarak kaydet
NOON_CREDENTIALS_PATH=./noon/store_credentials.json
NOON_API_BASE=https://api.noon.partners
NOON_COUNTRY=UAE

# =============================================
# Claude API (İçerik Üretimi için)
# =============================================
ANTHROPIC_API_KEY=

# =============================================
# Uygulama
# =============================================
DATABASE_URL=sqlite:///./dubai_ecommerce.db
SECRET_KEY=change-this-in-production
DEBUG=true
